        "type": "object",
        "required": [
          "FEBRE",
          "MIALGIA",
          "CEFALEIA",
          "VOMITO",
          "NAUSEA",
          "DOR_COSTAS",
          "ARTRALGIA",
          "DOR_RETRO",
          "RESUL_SORO",
          "RESUL_NS1",
          "EVOLUCAO",
          "ALRM_HIPOT",
          "ALRM_PLAQ",
          "ALRM_VOM",
          "ALRM_SANG",
          "ALRM_HEMAT",
          "ALRM_ABDOM",
          "ALRM_LETAR",
          "ALRM_HEPAT",
          "ALRM_LIQ",
          "GRAV_PULSO",
          "GRAV_CONV",
          "GRAV_ENCH",
          "GRAV_INSUF",
          "GRAV_TAQUI",
          "GRAV_EXTRE",
          "GRAV_HIPOT",
          "GRAV_HEMAT",
          "GRAV_MELEN",
          "GRAV_CONSC",
          "GRAV_ORGAO"
