            "example": 2
          },
          "GRAV_ENCH": {
            "type": "integer",
            "title": "Grav Ench",
            "description": "Sinal de gravidade: enchimento capilar alterado",
            "example": 2
          },
          "GRAV_INSUF": {
            "type": "integer",
