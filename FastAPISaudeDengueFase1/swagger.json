{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/predict": {
      "post": {
        "summary": "Realiza predição de hospitalizações de dengue",
        "description": "Endpoint responsável por receber dados clínicos do paciente e retornar a predição de hospitalização.",
        "operationId": "run_predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DengueInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DengueResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DengueInput": {
        "properties": {
          "FEBRE": {
            "type": "integer",
            "title": "Febre",
            "description": "Paciente apresentou febre? 1 = Sim, 2 = Não",
            "example": 1
          },
          "MIALGIA": {
            "type": "integer",
            "title": "Mialgia",
            "description": "Presença de mialgia (dor muscular)",
            "example": 1
          },
          "CEFALEIA": {
            "type": "integer",
            "title": "Cefaleia",
            "description": "Presença de cefaleia (dor de cabeça)",
            "example": 2
          },
          "VOMITO": {
            "type": "integer",
            "title": "Vomito",
            "description": "Paciente apresentou vômito",
            "example": 1
          },
          "NAUSEA": {
            "type": "integer",
            "title": "Nausea",
            "description": "Paciente presentation náusea",
            "example": 2
          },
          "DOR_COSTAS": {
            "type": "integer",
            "title": "Dor Costas",
            "description": "Presença de dor nas costas",
            "example": 1
          },
          "ARTRALGIA": {
            "type": "integer",
            "title": "Artralgia",
            "description": "Presença de artralgia (dor nas articulações)",
            "example": 1
          },
          "DOR_RETRO": {
            "type": "integer",
            "title": "Dor Retro",
