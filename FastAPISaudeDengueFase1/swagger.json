            "example": 2
          },
          "ALRM_HEMAT": {
            "type": "integer",
            "title": "Alrm Hemat",
            "description": "Sinal de alarme: alteração hematológica",
            "example": 2
          },
          "ALRM_ABDOM": {
            "type": "integer",
            "title": "Alrm Abdom",
            "description": "Sinal de alarme: dor abdominal intensa",
            "example": 2
          },
          "ALRM_LETAR": {
            "type": "integer",
            "title": "Alrm Letar",
            "description": "Sinal de alarme: letargia",
            "example": 2
          },
          "ALRM_HEPAT": {
            "type": "integer",
            "title": "Alrm Hepat",
            "description": "Sinal de alarme: aumento do fígado",
