            "example": 2
          },
          "RESUL_SORO": {
            "type": "integer",
            "title": "Resul Soro",
            "description": "Resultado do exame de soro",
            "example": 1
          },
          "RESUL_NS1": {
            "type": "integer",
            "title": "Resul Ns1",
            "description": "Resultado do exame NS1",
            "example": 2
          },
          "EVOLUCAO": {
            "type": "integer",
            "title": "Evolucao",
            "description": "Evolução do caso do paciente",
            "example": 1
          },
          "ALRM_HIPOT": {
            "type": "integer",
            "title": "Alrm Hipot",
            "description": "Sinal de alarme: hipotensão",
            "example": 2
          },
          "ALRM_PLAQ": {
            "type": "integer",
            "title": "Alrm Plaq",
