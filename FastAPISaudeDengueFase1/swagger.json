        "title": "DengueInput"
      },
      "DengueResponse": {
        "properties": {
          "predicao": {
            "type": "string",
            "title": "Predicao",
            "description": "Resultado textual da predição",
            "example": "Sim"
          },
          "codigo": {
            "type": "integer",
            "title": "Codigo",
            "description": "Código numérico retornado pelo modelo (1 ou 2)",
            "example": 1
          },
          "probabilidade": {
            "type": "number",
            "title": "Probabilidade",
            "description": "Probabilidade estimada pelo modelo",
            "example": 0.87
          },
          "mensagem": {
            "type": "string",
            "title": "Mensagem",
            "description": "Mensagem explicativa do resultado",
            "example": "Alta probabilidade de hospitalização positiva"
          }
        },
        "type": "object",
        "required": [
          "predicao",
          "codigo",
          "probabilidade",
          "mensagem"
        ],
        "title": "DengueResponse"
      },
      "ErroResponse": {
        "properties": {
          "erro": {
            "type": "string",
            "title": "Erro",
            "description": "Tipo do erro ocorrido",
            "example": "Erro de validação"
          },
          "detalhe": {
            "type": "string",
            "title": "Detalhe",
            "description": "Descrição detalhada do erro",
            "example": "Campo FEBRE inválido"
          }
        },
        "type": "object",
        "required": [
          "erro",
          "detalhe"
        ],
        "title": "ErroResponse"
      }
    }
  }
